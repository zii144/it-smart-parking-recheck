# macOS finder metadata
.DS_Store
**/.DS_Store

# Only .github/ is a real dot-directory for this repo — everything else
# starting with a dot (.claude/, superpowers state, editor/tool state, etc.)
# is local tooling, never committed.
.*/
!/.github/
CLAUDE.md
skills-lock.json

# Production secrets — never commit (see deploy/.env.production.example)
deploy/.env.production
target-sample/
manual.zip

# Personal work-tracking, local-only (see AIRules/progress_file_rules.md)
progress/

# Scratch planning docs, superseded by IMPLEMENTATION_LOG.md / devops_plan.md
proposed_*.md

# Local-only incident/bug log
bugs.md
